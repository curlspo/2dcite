# Database — local SQLite (current schema). Production: Postgres URL (see docs/DEPLOY.md)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/twodcite?schema=public"

# Auth (set a long random secret in production)
AUTH_SECRET="change-me-in-production-use-openssl-rand-hex-32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Stripe (optional in local dev — without keys, checkout uses dev mock pay → HELD)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Storage — local disk by default; production on Vercel needs Blob
# UPLOAD_DIR="/Users/you/2dcite/.uploads"
# BLOB_READ_WRITE_TOKEN=

# Email (optional)
# RESEND_API_KEY=
# EMAIL_FROM="2dcite <noreply@2dcite.com>"

# Production only: allow mock pay without Stripe (default off on Vercel production)
# ALLOW_DEV_MOCK_PAY=false
