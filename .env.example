# Database (SQLite for local; use Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Auth (set a long random secret in production)
AUTH_SECRET="change-me-in-production-use-openssl-rand-hex-32"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"

# Stripe (optional in local dev — without keys, checkout uses dev mock pay → HELD)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Storage (Phase 1+)
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Email (Phase 1+)
# RESEND_API_KEY=
# EMAIL_FROM="2dcite <noreply@2dcite.com>"
