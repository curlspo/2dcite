# =============================================================================
# 2dcite.com production environment (set these in Vercel → Project → Settings → Environment Variables)
# =============================================================================

# Required — Postgres (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Required — session signing / cookie security
AUTH_SECRET="generate-with: openssl rand -hex 32"

# Required — public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL="https://2dcite.com"
NEXT_PUBLIC_API_URL="https://2dcite.com/api/v1"

# Required for real payments (without these, checkout is blocked in production)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Required for durable file storage on Vercel (ephemeral FS otherwise)
# Option A — Vercel Blob (simplest on Vercel)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Option B — S3-compatible (R2 / AWS) — implement when token not set uses local only
# S3_BUCKET=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://....r2.cloudflarestorage.com

# Optional email
# RESEND_API_KEY=
# EMAIL_FROM="2dcite <noreply@2dcite.com>"

# Optional — force disable mock checkout even if Stripe missing (default true on Vercel production)
# ALLOW_DEV_MOCK_PAY=false
